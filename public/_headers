# Cloudflare Pages reads this file from the build output root.
# It mirrors vercel.json so the same commit deploys correctly on either host.
# Vite copies everything in public/ verbatim, so this lands in dist/_headers.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/mark.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
